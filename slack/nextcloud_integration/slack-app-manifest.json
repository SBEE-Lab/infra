{
  "display_information": {
    "name": "SjangLab Nextcloud Integration",
    "description": "Send files from SjangLab Nextcloud to Slack"
  },
  "oauth_config": {
    "redirect_urls": [
      "https://cloud.sjanglab.org/apps/integration_slack/oauth-redirect"
    ],
    "scopes": {
      "user": [
        "chat:write",
        "channels:read",
        "files:write",
        "groups:read",
        "im:read",
        "mpim:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": true
  }
}
