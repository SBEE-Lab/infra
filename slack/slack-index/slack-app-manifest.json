{
  "display_information": {
    "name": "SjangLab Slack Index",
    "description": "Read-only indexer that makes channel conversations and shared files searchable"
  },
  "features": {
    "bot_user": {
      "display_name": "slack-index",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:history",
        "groups:history",
        "files:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
