{
  "_metadata": {
    "major_version": 1,
    "minor_version": 2
  },
  "display_information": {
    "name": "Rami",
    "description": "Rami (Research Assistant for Managing Information), SBEE-Lab channel-scoped research agent with project-group access.",
    "background_color": "#1a1a2e"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "Rami",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/hermes",
        "description": "Talk to Rami or run a safe text-only subcommand",
        "should_escape": false,
        "url": "https://hermes-agent.local/slack/commands",
        "usage_hint": "[help|new|status|version|whoami]"
      }
    ],
    "agent_view": {
      "agent_description": "Mention Rami in approved project channels. Slack User Groups provide project membership; the broker enforces channel-scoped resource access. DMs and background actions remain disabled."
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "assistant:write",
        "channels:history",
        "channels:read",
        "chat:write",
        "commands",
        "users:read",
        "usergroups:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
