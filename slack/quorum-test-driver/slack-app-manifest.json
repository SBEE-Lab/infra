{
  "_metadata": {
    "major_version": 1,
    "minor_version": 2
  },
  "display_information": {
    "name": "Quorum Test Driver",
    "description": "Posts scripted messages into quorum test channels to exercise the collector",
    "background_color": "#4a4a4a"
  },
  "features": {
    "bot_user": {
      "display_name": "quorum-test-driver",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write", "files:write"],
      "user": ["chat:write", "files:write"]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
