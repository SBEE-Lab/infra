# shellcheck shell=bash
use flake ..#terraform

# R2 backend authentication
AWS_ACCESS_KEY_ID="$(sops -d --extract '["R2_STATE_ACCESS_KEY_ID"]' secrets.yaml)"
AWS_SECRET_ACCESS_KEY="$(sops -d --extract '["R2_STATE_SECRET_ACCESS_KEY"]' secrets.yaml)"
R2_STATE_ACCOUNT_ID="$(sops -d --extract '["R2_STATE_ACCOUNT_ID"]' secrets.yaml)"
R2_STATE_BUCKET="$(sops -d --extract '["R2_STATE_BUCKET"]' secrets.yaml)"
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY R2_STATE_ACCOUNT_ID R2_STATE_BUCKET
export TG_NON_INTERACTIVE=true
